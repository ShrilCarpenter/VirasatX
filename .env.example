# Supabase Configuration (Client-side variables for Auth, Favorites & Profiles)
# Retrieve these from your Supabase Project Settings -> API
VITE_SUPABASE_URL=""
VITE_SUPABASE_PUBLISHABLE_KEY=""

# Server-Side Google Gemini API Key (Required for live AI Guide & Vision AI)
# This key is strictly executed in serverless endpoints (/api/*) and dev middleware.
# NEVER expose this key in client-side code or VITE_* variables.
GEMINI_API_KEY=""

# Application Host URL
APP_URL="http://localhost:3000"
